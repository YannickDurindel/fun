; Engine configuration file.
config_version=5

[application]
config/name="Fun Racer"
run/main_scene="res://scenes/menu/menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]
Bootstrap="*res://scripts/bootstrap.gd"
Settings="*res://scripts/settings.gd"
Game="*res://scripts/game.gd"
SettingsApply="*res://scripts/settings_apply.gd"
Transitions="*res://scripts/ui/transitions.gd"
UISounds="*res://scripts/audio/ui_sounds.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[physics]
common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=16
common/physics_interpolation=true
3d/default_gravity=9.81

[rendering]
renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
